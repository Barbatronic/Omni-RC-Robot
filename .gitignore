# For PCBs designed using KiCad: https://www.kicad.org/
# Format documentation: https://kicad.org/help/file-formats/

# Temporary files
*.000
*.bak
*.bck
*.kicad_pcb-bak
*.kicad_sch-bak
*-backups
*-cache*
*-bak
*-bak*
*~
~*
_autosave-*
\#auto_saved_files\#
*.tmp
*-save.pro
*-save.kicad_pcb
fp-info-cache
~*.lck
\#auto_saved_files#

# Netlist files (exported from Eeschema)
*.net

# Autorouter files (exported from Pcbnew)
*.dsn
*.ses

# Exported BOM files
*.xml
*.csv

# Archived Backups (KiCad 6.0)
**/*-backups/*.zip

# Local git-based history (KiCad 9.0+)
.history

# Local project settings
*.kicad_prl
*.FCBak

# ==========================================================================
# Firmware ESP32-S3 (PlatformIO)
# ==========================================================================

# Repertoire de build et caches PlatformIO
.pio/
.pioenvs/
.piolibdeps/
.clang_complete
.gcc-flags.json
compile_commands.json

# Reglages locaux de l'editeur generes par PlatformIO
**/.vscode/.browse.c_cpp.db*
**/.vscode/c_cpp_properties.json
**/.vscode/launch.json
**/.vscode/ipch/

# --------------------------------------------------------------------------
# SECRETS : identifiants Wi-Fi.
# Ce fichier contient le SSID et le mot de passe du reseau et ne doit JAMAIS
# etre pousse sur GitHub. Le modele suivi par Git est wifi_secrets.example.h.
# --------------------------------------------------------------------------
wifi_secrets.h
**/include/wifi_secrets.h

# Exports de configuration du robot : peuvent contenir des mots de passe Wi-Fi
robot-config*.json
