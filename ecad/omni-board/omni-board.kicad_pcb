	(footprint "omni-footprints:ESP32-S3-Zero_THT"
		(layer "F.Cu")
		(uuid "65e3bcbb-b862-44cc-8bab-df03a067d8e6")
		(at 144.94 103.495)
		(descr "Waveshare ESP32-S3-Zero module (ESP32-S3FH4R2). Board 18.0 x 23.5 mm, 2 x 9 edge pins, 2.54 mm pitch, 15.24 mm row spacing - mechanically identical to the ESP32-C3-Zero. USB-C overhangs the top edge. NOTE: the extra bottom-edge pads (GP14/15/16) and the rear-side pads (GP17, GP18, GP38-GP42, GP45) are NOT modelled here. Variante traversante : trous metallises 1.0 mm, barrettes 2x9 au pas 2.54.")
		(tags "ESP32 ESP32-S3 Waveshare Zero module wifi ble RISC-V")
